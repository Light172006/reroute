# ==============================================================================
# Reroute Agent Runtime Configuration (.env.example)
# Note: Check current provider documentation for available models and rate limits.
# ==============================================================================

# LLM Fallback Chains (comma-separated provider:model pairs)
# Supported providers: gemini, groq, ollama
LLM_STRONG_CHAIN=gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile
LLM_SMALL_CHAIN=groq:llama-3.1-8b-instant,gemini:gemini-2.5-flash
LLM_LOCAL_CHAIN=ollama:qwen2.5:7b,ollama:llama3.2:3b

# Provider API Keys
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ORS_API_KEY=

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Tool Layer and Simulation Toggles
MOCK_TOOLS=false
MOCK_LLM=false

# Rate Limiting and Token Bucket Settings
LLM_RATE_LIMIT_RPS=2.0
LLM_TOKEN_BURST=10

# Database and Checkpointer Configuration
DATABASE_URL=postgresql+asyncpg://reroute:reroute@localhost:5432/reroute

# Region-specific Planner Rules Thresholds
ALTITUDE_ACCLIMATIZATION_THRESHOLD_M=1000
ALTITUDE_HIGH_RISK_THRESHOLD_M=3000
MAX_DRIVE_HOURS_PER_DAY=7
ALLOW_NIGHT_DRIVING=false
