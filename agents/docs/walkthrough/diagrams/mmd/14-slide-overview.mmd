flowchart LR
  classDef toolNode fill:#fce7f3,stroke:#db2777,stroke-width:2px;
  classDef codeNode fill:#e0f2fe,stroke:#0284c7,stroke-width:2px;
  classDef llmNode fill:#fef3c7,stroke:#d97706,stroke-width:2px;
