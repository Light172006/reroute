# Reroute Backend Environment Configuration
# Copy this file to .env and update values as needed.

# --- Database ---
# PostgreSQL connection URL (asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reroute

# --- JWT Authentication ---
# Secret key for signing JWT tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# --- Agent / LLM Configuration ---
# Set to false to use real LLM API calls instead of mocks
MOCK_TOOLS=true

# API keys (optional, only needed when MOCK_TOOLS=false)
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=